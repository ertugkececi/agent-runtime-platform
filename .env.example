AGENT_RUNTIME_DATABASE_URL=sqlite:///./data/agent_runtime.db

# Optional administrator-managed stdio MCP catalog (never accepted from API requests).
# Only names in read_only_tools can be assigned to agents; readOnlyHint alone grants no trust.
# AGENT_RUNTIME_MCP_SERVERS={"docs":{"command":"uvx","args":["example-readonly-mcp"],"env_vars":["DOCS_TOKEN"],"read_only_tools":["search","fetch"]}}

# Optional single-legacy-user OIDC gate. Leave mode=off until every value is fixed and tested.
# Never commit real issuer credentials or provider secrets.
# AGENT_RUNTIME_AUTH_MODE=off
# AGENT_RUNTIME_OIDC_ISSUER=https://id.example.com/issuer
# AGENT_RUNTIME_OIDC_CLIENT_ID=agent-runtime
# AGENT_RUNTIME_OIDC_REDIRECT_URI=https://runtime.example.com/auth/callback
# AGENT_RUNTIME_OIDC_LEGACY_SUB=exact-bootstrap-subject
# AGENT_RUNTIME_OIDC_LEGACY_TENANT=legacy
# AGENT_RUNTIME_OIDC_SESSION_TTL_SECONDS=28800

# Feature flags gate new behaviour and default to off; blank means off.
# A flag is not a policy: security behaviour stays unconditional.
# Declared in src/agent_runtime_platform/features.py.
# AGENT_RUNTIME_FEATURE_PROVIDER_OPENCODE=off

# OpenCode adapter: per-call wall-clock budget (seconds) for the TypeScript bridge host.
# Default 600, capped at 3600; the adapter force-kills the host on expiry.
# AGENT_RUNTIME_OPENCODE_TIMEOUT_SECONDS=600
